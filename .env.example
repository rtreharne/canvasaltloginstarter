DEBUG=True
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
APP_BASE_URL=http://localhost:8998

CANVAS_API_URL=https://your-canvas-instance.instructure.com
CANVAS_API_TOKEN=replace-with-canvas-token

POSTGRES_DB=canvas_magic
POSTGRES_USER=canvas_magic
POSTGRES_PASSWORD=canvas_magic
POSTGRES_HOST=db
POSTGRES_PORT=5432

# For Canvas iframe usage, keep this True so cookies are sent cross-site.
CROSS_SITE_COOKIES=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Optional: comma-separated explicit origins (scheme+host[:port])
# CSRF_TRUSTED_ORIGINS=https://your-app.example.com

# Optional: auto-create Django admin user on container startup.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-this-password
